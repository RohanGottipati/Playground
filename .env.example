# Supabase (optional locally: without these the app stores data in memory)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backboard AI gateway (required for photo analysis)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=
BACKBOARD_PRIMARY_PROVIDER=openai
BACKBOARD_PRIMARY_MODEL=gpt-4o

# Per-attempt Backboard request timeout in ms (optional, default 25000)
# BACKBOARD_TIMEOUT_MS=25000

# Dev-only: force every generation onto one template id (ignored in production)
# PLAYGROUND_FORCE_TEMPLATE=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared secret required to unpublish a game
GAME_EVENT_SECRET=
