{
  "name": "playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm test",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "components:check": "node scripts/sync-component-catalog.mjs --dry-run",
    "components:sync": "node scripts/sync-component-catalog.mjs",
    "components:backfill": "node scripts/backfill-game-component-ids.mjs",
    "sprites:generate": "tsx scripts/generate-sprites.mts",
    "previews:generate": "tsx scripts/generate-template-previews.mts",
    "assets:generate": "npm run sprites:generate && npm run previews:generate",
    "assets:check": "vitest run tests/assets.test.ts tests/previewImages.test.ts",
    "templates:seed": "tsx scripts/seed-template-games.mts",
    "test:deployment": "tsx scripts/smoke-deployment.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "framer-motion": "11.18.2",
    "next": "15.5.22",
    "phaser": "^3.90.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "4.1.10"
  }
}
